# Copy this file to .env and fill in real values. Never commit .env.
#
# MongoDB Atlas (needs outbound TCP 27017, which some networks block):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
#
# Local MongoDB Community Server on loopback (works even when 27017 egress is blocked):
# MONGODB_URI=mongodb://127.0.0.1:27017/inventory-management
PORT=3000
